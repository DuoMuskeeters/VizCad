{
	"name": "vizcad",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.3",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"size:viewer": "node scripts/viewer-bundle-size.ts",
		"preview": "pnpm run build && vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check": "pnpm check:migrations && pnpm typecheck && pnpm test",
		"check:migrations": "node scripts/check-migrations.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply vizcad_auth --local",
		"db:migrate:staging": "node scripts/staging.ts migrate",
		"db:backfill:local": "node scripts/backfillPersonalWorkspaces.ts .wrangler/backfill-personal-workspaces.sql && wrangler d1 execute vizcad_auth --local --file=.wrangler/backfill-personal-workspaces.sql",
		"db:backfill:staging": "node scripts/staging.ts backfill",
		"db:materialize:local": "node scripts/materializeLegacyTranslations.ts --local",
		"db:materialize:staging": "node scripts/staging.ts materialize",
		"deploy:staging": "node scripts/staging.ts deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@fontsource-variable/figtree": "^5.2.0",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.7",
		"aws4fetch": "1.0.20",
		"better-auth": "1.4.7",
		"drizzle-orm": "0.45.4",
		"effect": "4.1.5",
		"fflate": "0.8.3",
		"hast-util-to-html": "9.0.6",
		"lucide-react": "^1.78.0",
		"mdast-util-from-markdown": "2.1.0",
		"mdast-util-gfm": "3.1.0",
		"mdast-util-to-hast": "13.2.1",
		"micromark-extension-gfm": "3.0.0",
		"occt-import-js": "0.0.23",
		"radix-ui": "^1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwindcss": "4.3.5",
		"three": "0.187.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.70.1",
		"@effect/vitest": "4.1.5",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/hast": "3.0.4",
		"@types/mdast": "4.0.4",
		"@types/node": "^24.0.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.187.0",
		"@vitejs/plugin-react": "6.3.0",
		"drizzle-kit": "0.31.11",
		"jsdom": "^31.0.1",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.1",
		"wrangler": "4.166.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"workerd"
		]
	}
}
