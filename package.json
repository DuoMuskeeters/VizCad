{
	"name": "vizcad",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.3",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "pnpm run build && vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check": "pnpm check:migrations && pnpm typecheck && pnpm test",
		"check:migrations": "node scripts/check-migrations.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply vizcad_auth --local",
		"db:migrate:staging": "node scripts/staging.ts migrate",
		"deploy:staging": "node scripts/staging.ts deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.2.0",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.7",
		"aws4fetch": "1.0.20",
		"better-auth": "1.4.7",
		"drizzle-orm": "0.45.4",
		"effect": "4.1.5",
		"lucide-react": "^1.78.0",
		"radix-ui": "^1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwindcss": "4.3.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.70.1",
		"@effect/vitest": "4.1.5",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "^24.0.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"drizzle-kit": "0.31.11",
		"jsdom": "^31.0.1",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.1",
		"wrangler": "4.166.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"workerd"
		]
	}
}
