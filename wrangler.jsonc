/**
 * Cloudflare Worker config for the rewrite. See docs/00-refactor-plan.md §2–3.
 *
 * DATA SAFETY: `vizcad_auth` (D1) and `vizcad-files-bucket` (R2) are the PRODUCTION resources with live
 * user data. Binding names are kept from the old app on purpose (cutover reuses them). Never run
 * `--remote` migrations, `d1 execute --remote` or R2 writes/deletes without asking (CLAUDE.md).
 * `pnpm dev` uses local Miniflare state under .wrangler/, not production.
 *
 * Production secrets (wrangler secret put / dashboard), names kept from the old app:
 *   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY (presigned URLs, aws4fetch),
 *   optional R2_BUCKET_NAME, R2_ENDPOINT; BETTER_AUTH_SECRET, BETTER_AUTH_URL, GOOGLE_CLIENT_ID,
 *   GOOGLE_CLIENT_SECRET, RESEND_API_KEY (Faz 3).
 * New in the rewrite: TURNSTILE_SECRET, optional CF_ZONE_ID + CF_PURGE_TOKEN (edge cache purge, D4).
 * Do not add any of the old secret names under `vars`: a var that collides with a secret fails the deploy.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vizcad",
	"compatibility_date": "2026-11-19",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"vars": {
		"SITE_URL": "https://viz-cad.com",
		"EMAIL_FROM": "noreply@viz-cad.com",
		"EMAIL_FROM_NAME": "VizCad"
	},
	// Cloudflare Email Service (replaces Resend in Faz 3). Not restricted to one destination:
	// verification, password reset and invites go to arbitrary users.
	"send_email": [{ "name": "EMAIL" }],
	"d1_databases": [
		{
			"binding": "vizcad_auth",
			"database_name": "vizcad_auth",
			"database_id": "9f3e6552-67bb-4dfa-a657-36907390a595",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2_FILES_BUCKET",
			"bucket_name": "vizcad-files-bucket"
		}
	]
}
